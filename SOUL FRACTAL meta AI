class AutoLanguageGenerator:
    def __init__(self, registry: LanguageRegistry, kernel):
        self.registry = registry
        self.kernel = kernel
        self.counter = 0

    def generate(self, sample_code: str):
        name = f"lang_auto_{self.counter}"
        self.counter += 1

        grammar = {
            "symbols": ["+", "-", "*", "/", "=", "(", ")"]
        }

        def executor(ast, world, kernel):
            env = world.current_timeline.state.setdefault(name, {})
            def eval_node(n):
                if n.type == "Number":
                    return n.value
                if n.type == "Identifier":
                    return env.get(n.value)
                if n.type == "Assign":
                    val = eval_node(n.children[0])
                    env[n.value] = val
                    return val
                if n.type == "BinaryOp":
                    a = eval_node(n.children[0])
                    b = eval_node(n.children[1])
                    if n.value == "+": return a + b
                    if n.value == "-": return a - b
                    if n.value == "*": return a * b
                    if n.value == "/": return a / b
                if n.type == "ExprStmt":
                    return eval_node(n.children[0])
                if n.type == "Program":
                    last = None
                    for c in n.children:
                        last = eval_node(c)
                    return last
                return None
            return eval_node(ast)

        self.registry.register_language(name, grammar, executor)
        return name


