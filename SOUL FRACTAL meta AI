# ---- AST Builder (simple expression + statement language) ----

class ASTBuilder:
    def __init__(self, tokens: List[Token]):
        self.tokens = tokens
        self.pos = 0

    def _peek(self) -> Optional[Token]:
        if self.pos < len(self.tokens):
            return self.tokens[self.pos]
        return None

    def _advance(self) -> Optional[Token]:
        tok = self._peek()
        if tok is not None:
            self.pos += 1
        return tok

    def _match(self, types: List[str], values: Optional[List[Any]] = None) -> Optional[Token]:
        tok = self._peek()
        if tok is None:
            return None
        if tok.type in types:
            if values is None or tok.value in values:
                self.pos += 1
                return tok
        return None

    def parse_program(self) -> ASTNode:
        children = []
        while self._peek() is not None:
            stmt = self.parse_statement()
            if stmt is not None:
                children.append(stmt)
            else:
                # consume one token to avoid infinite loop
                self._advance()
        return ASTNode(type="Program", children=children)

    def parse_statement(self) -> Optional[ASTNode]:
        # assignment: IDENT '=' expr
        tok = self._peek()
        if tok and tok.type == "IDENT":
            # lookahead for '='
            ident_tok = tok
            if len(self.tokens) > self.pos + 1 and self.tokens[self.pos + 1].type == "SYMBOL" and self.tokens[self.pos + 1].value == "=":
                self._advance()  # IDENT
                self._advance()  # '='
                expr = self.parse_expression()
                return ASTNode(
                    type="Assign",
                    value=ident_tok.value,
                    children=[expr]
                )
        # fallback: expression statement
        expr = self.parse_expression()
        if expr is not None:
            return ASTNode(type="ExprStmt", children=[expr])
        return None

    def parse_expression(self) -> Optional[ASTNode]:
        # simple left-associative binary expressions with + and -
        node = self.parse_term()
        while True:
            tok = self._peek()
            if tok and tok.type == "SYMBOL" and tok.value in ["+", "-"]:
                op = self._advance()
                right = self.parse_term()
                node = ASTNode(type="BinaryOp", value=op.value, children=[node, right])
            else:
                break
        return node

    def parse_term(self) -> Optional[ASTNode]:
        # simple left-associative binary expressions with * and /
        node = self.parse_factor()
        while True:
            tok = self._peek()
            if tok and tok.type == "SYMBOL" and tok.value in ["*", "/"]:
                op = self._advance()
                right = self.parse_factor()
                node = ASTNode(type="BinaryOp", value=op.value, children=[node, right])
            else:
                break
        return node

    def parse_factor(self) -> Optional[ASTNode]:
        tok = self._peek()
        if tok is None:
            return None

        if tok.type == "NUMBER":
            self._advance()
            return ASTNode(type="Number", value=tok.value)

        if tok.type == "STRING":
            self._advance()
            return ASTNode(type="String", value=tok.value)

        if tok.type == "IDENT":
            self._advance()
            return ASTNode(type="Identifier", value=tok.value)

        if tok.type == "SYMBOL" and tok.value == "(":
            self._advance()
            expr = self.parse_expression()
            self._match(["SYMBOL"], [")"])
            return expr

        # unknown token, consume and return None
        self._advance()
        return None


