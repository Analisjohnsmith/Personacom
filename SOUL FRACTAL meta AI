class RuriTimelineSync:
    def __init__(self, kernel: Kernel, tlm: TimelineManager, rpc: RuriRPC):
        self.kernel = kernel
        self.tlm = tlm
        self.rpc = rpc

        rpc.register("timeline.diff", self._rpc_diff)
        rpc.register("timeline.merge", self._rpc_merge)
        rpc.register("timeline.snapshot", self._rpc_snapshot)

    def _rpc_diff(self, name_a: str, name_b: str):
        return self.tlm.diff(name_a, name_b)

    def _rpc_merge(self, base: str, other: str, strategy: str = "coherence"):
        self.tlm.merge(base, other, strategy)
        return {"merged": True}

    def _rpc_snapshot(self, name: str):
        self.tlm.snapshot(name)
        return {"snapshot": name}

    def sync_with(self, host: str, port: int, peer_id: str, local_snap: str, remote_snap: str):
        diff = self.rpc.call(host, port, peer_id, "timeline.diff", local_snap, remote_snap)
        return diff


