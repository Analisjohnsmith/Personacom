    last_update: float


class RuriTrustModel:
    def __init__(self, kernel: Kernel):
        self.kernel = kernel
        self.records: Dict[str, RuriTrustRecord] = {}

    def update(self, node_id: str, delta: float):
        rec = self.records.get(node_id)
        if not rec:
            rec = RuriTrustRecord(node_id=node_id, score=1.0, last_update=time.time())
            self.records[node_id] = rec
        rec.score = max(0.0, min(1.0, rec.score + delta))
        rec.last_update = time.time()
        self.kernel.log(f"[TRUST] Node {node_id} trust={rec.score:.3f}")

    def get(self, node_id: str) -> float:
        rec = self.records.get(node_id)
        return rec.score if rec else 1.0


