import socket
import threading
import json


# -------------------------------------------------------------------------
# LOW-LEVEL TRANSPORT (TCP-LIKE MESSAGE PASSING)
# -------------------------------------------------------------------------

class RuriTransport:
    def __init__(self, kernel: Kernel, netsec: RuriNetworkSecurity, port: int = 5050):
        self.kernel = kernel
        self.netsec = netsec
        self.port = port
        self.running = False
        self.handlers: Dict[str, Callable[[Dict[str, Any]], Dict[str, Any]]] = {}

    def start(self):
        self.running = True
        thread = threading.Thread(target=self._listen, daemon=True)
        thread.start()
        self.kernel.log(f"[RURINET] Transport listening on port {self.port}")

    def stop(self):
        self.running = False

    def _listen(self):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.bind(("0.0.0.0", self.port))
        s.listen(5)

        while self.running:
            conn, addr = s.accept()
            data = conn.recv(65536)
            if not data:
                conn.close()
                continue

            try:
                packet = json.loads(data.decode())
                peer = packet.get("peer")
                if self.netsec.verify(peer, packet):
                    topic = packet["payload"].get("topic")
                    handler = self.handlers.get(topic)
                    if handler:
                        response = handler(packet["payload"])
                        conn.send(json.dumps(response).encode())
                else:
                    self.kernel.log(f"[RURINET] Dropped packet from {peer}")
            except Exception as e:
                self.kernel.log(f"[RURINET] Error: {e}")

            conn.close()

    def register_handler(self, topic: str, fn: Callable[[Dict[str, Any]], Dict[str, Any]]):
        self.handlers[topic] = fn
        self.kernel.log(f"[RURINET] Handler registered for topic: {topic}")

    def send(self, host: str, port: int, peer_id: str, topic: str, payload: Dict[str, Any]):
        packet = self.netsec.encrypt(peer_id, {"topic": topic, **payload})
        packet["peer"] = self.netsec.public_key

        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            s.connect((host, port))
            s.send(json.dumps(packet).encode())
            resp = s.recv(65536)
            if resp:
                return json.loads(resp.decode())
        except Exception as e:
            self.kernel.log(f"[RURINET] Send error: {e}")
        finally:
            s.close()
        return None


# -------------------------------------------------------------------------
# RPC LAYER (REMOTE SERVICE INVOCATION)
# -------------------------------------------------------------------------

class RuriRPC:
    def __init__(self, kernel: Kernel, transport: RuriTransport):
        self.kernel = kernel
        self.transport = transport
        self.registry: Dict[str, Callable[..., Any]] = {}

    def register(self, name: str, fn: Callable[..., Any]):
        self.registry[name] = fn
        self.kernel.log(f"[RPC] Registered: {name}")

        def handler(payload):
            args = payload.get("args", [])
            kwargs = payload.get("kwargs", {})
            try:
                result = fn(*args, **kwargs)
                return {"status": "ok", "result": result}
            except Exception as e:
                return {"status": "error", "error": str(e)}

        self.transport.register_handler(name, handler)

    def call(self, host: str, port: int, peer_id: str, name: str, *args, **kwargs):
        return self.transport.send(
            host, port, peer_id, name,
            {"args": args, "kwargs": kwargs}
        )


