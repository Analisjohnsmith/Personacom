class LanguageScheduler:
    def __init__(self, world, kernel):
        self.world = world
        self.kernel = kernel

    def schedule(self, code: str, lang: str, delay: int = 0):
        q = self.world.current_timeline.state.setdefault("scheduled_code", [])
        q.append({"code": code, "lang": lang, "delay": delay})

    def tick(self):
        q = self.world.current_timeline.state.get("scheduled_code", [])
        ready = []
        remaining = []
        for item in q:
            if item["delay"] <= 0:
                ready.append(item)
            else:
                item["delay"] -= 1
                remaining.append(item)
        self.world.current_timeline.state["scheduled_code"] = remaining
        return ready


