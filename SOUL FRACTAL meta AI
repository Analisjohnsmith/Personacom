# ---- Semantic Unification of AST Nodes ----

class ASTSemanticUnifier:
    def __init__(self, world, kernel):
        self.world = world
        self.kernel = kernel

    def unify(self, ast: ASTNode):
        stack = [ast]
        freq = {}
        while stack:
            node = stack.pop()
            freq[node.type] = freq.get(node.type, 0) + 1
            for child in node.children:
                stack.append(child)

        for t, count in freq.items():
            if count >= 3:
                ent = f"AST_{t}_{count}"
                if ent not in self.world.ontology:
                    self.world.define_entity(ent, {"node_type": t, "count": count})


