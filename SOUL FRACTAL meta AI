        if node.type == "BinaryOp":
            left = eval_node(node.children[0])
            right = eval_node(node.children[1])
            if node.value == "+":
                return left + right
            if node.value == "-":
                return left - right
            if node.value == "*":
                return left * right
            if node.value == "/":
                return left / right
        if node.type == "Assign":
            val = eval_node(node.children[0])
            env[node.value] = val
            return val
        if node.type == "ExprStmt":
            return eval_node(node.children[0])
        if node.type == "Program":
            last = None
            for child in node.children:
                last = eval_node(child)
            return last
        return None

    result = eval_node(ast)
    kernel.log(f"[EXPR_LANG] Result: {result}")
    return result


def register_expr_language(registry: LanguageRegistry):
    grammar = {
        "symbols": ["+", "-", "*", "/", "=", "(", ")"]
    }
    registry.register_language("expr", grammar, expr_lang_executor)
