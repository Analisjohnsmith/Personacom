static process_t procs[MAX_PROCS];
static uint64_t current = 0;

void process_init(void) {
    for (int i = 0; i < MAX_PROCS; i++) {
        procs[i].pid = i;
        procs[i].state = PROC_UNUSED;
    }
}

int process_create(void (*entry)(void)) {
    for (int i = 0; i < MAX_PROCS; i++) {
        if (procs[i].state == PROC_UNUSED) {
            procs[i].state = PROC_READY;
            procs[i].rip = (uint64_t)entry;
            procs[i].rsp = (uint64_t)&procs[i].stack[PROC_STACK_SIZE - 16];
            return i;
        }
    }
    return -1;
}

void process_schedule(void) {
    uint64_t next = (current + 1) % MAX_PROCS;

    for (int i = 0; i < MAX_PROCS; i++) {
        uint64_t idx = (next + i) % MAX_PROCS;
        if (procs[idx].state == PROC_READY) {
            current = idx;
            procs[idx].state = PROC_RUNNING;

            __asm__ volatile(
                "mov %0, %%rsp\n"
                "jmp *%1\n"
                :
                : "r"(procs[idx].rsp), "r"(procs[idx].rip)
