# ---- Bytecode Instructions ----

@dataclass
class Instruction:
    op: str
    arg: Any = None


# ---- Bytecode Compiler ----

class BytecodeCompiler:
    def compile(self, ast: ASTNode) -> List[Instruction]:
        code = []
        self._emit_node(ast, code)
        return code

    def _emit_node(self, node: ASTNode, code: List[Instruction]):
        t = node.type

        if t == "Program":
            for child in node.children:
                self._emit_node(child, code)
            return

        if t == "Number":
            code.append(Instruction("PUSH", node.value))
            return

        if t == "String":
            code.append(Instruction("PUSH", node.value))
            return

        if t == "Identifier":
            code.append(Instruction("LOAD", node.value))
            return

        if t == "Assign":
            self._emit_node(node.children[0], code)
            code.append(Instruction("STORE", node.value))
            return

        if t == "BinaryOp":
            self._emit_node(node.children[0], code)
            self._emit_node(node.children[1], code)
            if node.value == "+":
                code.append(Instruction("ADD"))
            elif node.value == "-":
                code.append(Instruction("SUB"))
            elif node.value == "*":
                code.append(Instruction("MUL"))
            elif node.value == "/":
                code.append(Instruction("DIV"))
            return

        if t == "ExprStmt":
            self._emit_node(node.children[0], code)
            code.append(Instruction("POP"))
            return


# ---- Virtual Machine ----

class BytecodeVM:
    def __init__(self, world, kernel):
        self.world = world
        self.kernel = kernel
        self.stack: List[Any] = []
        self.env = world.current_timeline.state.setdefault("vm_env", {})

    def run(self, code: List[Instruction]):
        ip = 0
        while ip < len(code):
            instr = code[ip]
            op = instr.op

            if op == "PUSH":
                self.stack.append(instr.arg)

            elif op == "LOAD":
                self.stack.append(self.env.get(instr.arg))

            elif op == "STORE":
                val = self.stack.pop()
                self.env[instr.arg] = val

            elif op == "ADD":
                b = self.stack.pop()
                a = self.stack.pop()
                self.stack.append(a + b)

            elif op == "SUB":
                b = self.stack.pop()
                a = self.stack.pop()
                self.stack.append(a - b)

            elif op == "MUL":
                b = self.stack.pop()
                a = self.stack.pop()
                self.stack.append(a * b)

            elif op == "DIV":
                b = self.stack.pop()
                a = self.stack.pop()
                self.stack.append(a / b)

            elif op == "POP":
                self.stack.pop()

            ip += 1

        return self.stack[-1] if self.stack else None


