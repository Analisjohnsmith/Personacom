@dataclass
class RuriNetSession:
    peer_id: str
    shared_key: bytes
    established: float
    last_used: float


class RuriNetworkSecurity:
    def __init__(self, kernel: Kernel, trust: RuriTrustModel):
        self.kernel = kernel
        self.trust = trust
        self.sessions: Dict[str, RuriNetSession] = {}
        self.private_key = ruri_key()
        self.public_key = ruri_hash(self.private_key)

    def establish_session(self, peer_id: str, peer_pub: str):
        shared = ruri_hash(self.private_key + peer_pub.encode())
        key = shared.encode()[:32]
        sess = RuriNetSession(
            peer_id=peer_id,
            shared_key=key,
            established=time.time(),
            last_used=time.time()
        )
        self.sessions[peer_id] = sess
        self.kernel.log(f"[NETSEC] Session established with {peer_id}")
        return sess

    def encrypt(self, peer_id: str, payload: Dict[str, Any]) -> Dict[str, Any]:
        sess = self.sessions.get(peer_id)
        if not sess:
            raise ValueError(f"No session with peer {peer_id}")
        sess.last_used = time.time()
        raw = str(payload).encode()
        mac = ruri_hmac(sess.shared_key, raw)
        return {"payload": payload, "mac": mac}

    def verify(self, peer_id: str, packet: Dict[str, Any]) -> bool:
        sess = self.sessions.get(peer_id)
        if not sess:
            return False
        raw = str(packet["payload"]).encode()
        mac = ruri_hmac(sess.shared_key, raw)
        ok = mac == packet["mac"]
        if not ok:
            self.trust.update(peer_id, -0.1)
            self.kernel.log(f"[NETSEC] MAC FAIL from {peer_id}")
        else:
            self.trust.update(peer_id, +0.01)
        return ok


