@dataclass
class Permission:
    name: str
    description: str = ""
    scope: str = "global"  # e.g. "global", "service", "timeline"


@dataclass
class CapabilityGrant:
    capability: str
    permissions: List[str] = field(default_factory=list)
    constraints: Dict[str, Any] = field(default_factory=dict)


@dataclass
class SecurityContext:
    subject_id: str
    subject_type: str  # "service", "agent", "loop", "external"
    grants: Dict[str, CapabilityGrant] = field(default_factory=dict)
    tags: List[str] = field(default_factory=list)


class SecurityPolicy:
    def __init__(self, kernel: Kernel):
        self.kernel = kernel
        self.permissions: Dict[str, Permission] = {}
        self.default_grants: Dict[str, CapabilityGrant] = {}

    def define_permission(self, name: str, description: str = "", scope: str = "global"):
        self.permissions[name] = Permission(name=name, description=description, scope=scope)
        self.kernel.log(f"[SEC] Permission defined: {name} (scope={scope})")

    def define_default_grant(self, capability: str, permissions: List[str], constraints: Dict[str, Any] = None):
        self.default_grants[capability] = CapabilityGrant(
            capability=capability,
            permissions=list(permissions),
            constraints=constraints or {},
        )
        self.kernel.log(f"[SEC] Default grant for capability: {capability}")

    def get_default_grant(self, capability: str) -> Optional[CapabilityGrant]:
        return self.default_grants.get(capability)


class SecurityManager:
    def __init__(self, kernel: Kernel, policy: SecurityPolicy):
        self.kernel = kernel
        self.policy = policy
        self.contexts: Dict[str, SecurityContext] = {}

    def create_context(self, subject_id: str, subject_type: str, tags: Optional[List[str]] = None) -> SecurityContext:
        ctx = SecurityContext(subject_id=subject_id, subject_type=subject_type, tags=tags or [])
        self.contexts[subject_id] = ctx
        self.kernel.log(f"[SEC] Security context created: {subject_type}#{subject_id}")
        return ctx

    def grant_capability(self, subject_id: str, capability: str,
                         permissions: Optional[List[str]] = None,
                         constraints: Optional[Dict[str, Any]] = None):
        ctx = self.contexts.get(subject_id)
        if not ctx:
            raise ValueError(f"No security context for subject: {subject_id}")
        if permissions is None:
            default = self.policy.get_default_grant(capability)
            if default:
                permissions = list(default.permissions)
                base_constraints = dict(default.constraints)
                if constraints:
                    base_constraints.update(constraints)
                constraints = base_constraints
        grant = CapabilityGrant(
            capability=capability,
            permissions=permissions or [],
            constraints=constraints or {},
        )
        ctx.grants[capability] = grant
        self.kernel.log(f"[SEC] Granted {capability} to {subject_id} with perms={grant.permissions}")

    def check(self, subject_id: str, capability: str, permission: str, context: Optional[Dict[str, Any]] = None) -> bool:
        ctx = self.contexts.get(subject_id)
        if not ctx:
            self.kernel.log(f"[SEC] DENY (no context): {subject_id} -> {capability}.{permission}")
            return False
        grant = ctx.grants.get(capability)
        if not grant:
            self.kernel.log(f"[SEC] DENY (no grant): {subject_id} -> {capability}.{permission}")
            return False
        if permission not in grant.permissions:
            self.kernel.log(f"[SEC] DENY (no permission): {subject_id} -> {capability}.{permission}")
            return False
        if context and grant.constraints:
            for k, v in grant.constraints.items():
                if k in context and context[k] != v:
                    self.kernel.log(f"[SEC] DENY (constraint mismatch {k}): {subject_id} -> {capability}.{permission}")
