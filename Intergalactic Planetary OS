def main() -> None:
    parser = argparse.ArgumentParser(description="HELLA - Sovereign Package Manager")

    # FIX #14 — add --version flag
    parser.add_argument(
        "--version", action="version", version=f"HELLA {__version__}"
    )

    parser.add_argument(
        "command",
        choices=[
            "create", "publish", "install", "uninstall",
            "list", "search", "info", "compress", "decompress",
            "register",
        ],
        help="Command to run",
    )
    parser.add_argument("--name", "-n", help="Package name")
    parser.add_argument("--ver", help="Package version")
    parser.add_argument("--author", "-a", help="Package author")
    parser.add_argument("--description", "-d", help="Package description")
    parser.add_argument("--files", "-f", nargs="+", help="Files to package")
    parser.add_argument("--deps", help="Dependencies (comma-separated)")
    parser.add_argument("--target", "-t", default="./installed", help="Install target directory")
    parser.add_argument("--query", "-q", help="Search query")
    parser.add_argument("--input", "-i", help="Input file for compress/decompress")
    parser.add_argument("--output", "-o", help="Output file for compress/decompress")
    parser.add_argument(
        "--method", "-m", default="gzip",
        choices=["gzip", "zlib", "none"],
        help="Compression method",
    )
    parser.add_argument(
        "--verbose", action="store_true", help="Enable debug logging"
    )

    args = parser.parse_args()

    if args.verbose:
        logger.setLevel(logging.DEBUG)

    hella = HELLAPackageManager()

    if args.command == "create":
        if not all([args.name, args.ver, args.author, args.description, args.files]):
            print("❌ Missing required arguments: --name, --ver, --author, --description, --files")
            return
        deps = args.deps.split(",") if args.deps else None
        hella.create_package(
            args.name, args.ver, args.author,
            args.description, args.files, deps,
        )

    elif args.command == "publish":
        if not all([args.name, args.ver, args.author, args.description, args.files]):
            print("❌ Missing required arguments")
            return
        deps = args.deps.split(",") if args.deps else None
        hella.publish(
            args.name, args.ver, args.author,
            args.description, args.files, deps,
        )

    elif args.command == "install":
        if not args.name:
            print("❌ Missing --name")
            return
        hella.install(args.name, args.ver, args.target)

    elif args.command == "uninstall":
        if not args.name:
            print("❌ Missing --name")
            return
        hella.uninstall(args.name, args.ver)

    elif args.command == "list":
        packages = hella.list_packages()
        print(f"\n📦 Available packages ({len(packages)}):")
        for pkg in packages:
            print(f"   {pkg}")

    elif args.command == "search":
        if not args.query:
            print("❌ Missing --query")
            return
        results = hella.search(args.query)
        print(f"\n🔍 Search results for '{args.query}':")
        for r in results:
            print(f"   {r['name']} v{r['version']} - {r['description'][:50]}...")

    elif args.command == "info":
        if not args.name:
            print("❌ Missing --name")
            return
        info = hella.info(args.name, args.ver)
        if info:
            print(f"\n📄 Package: {info['name']} v{info['version']}")
            print(f"   Author: {info['author']}")
            print(f"   Description: {info['description']}")
            print(f"   Dependencies: {', '.join(info['dependencies']) or 'none'}")
            print(f"   Files: {info['files']}")
            print(f"   Size: {info['size_bytes']:,} bytes")
            print(f"   Compressed: {info['compressed_bytes']:,} bytes")
            print(f"   Compression: {info['compression_ratio']:.1f}% ({info['compression_method']})")
            print(f"   Hash: {info['hash']}")
            print(f"   Created: {info['created']}")
        else:
            print(f"❌ Package '{args.name}' not found")

    elif args.command == "compress":
        if not args.input:
            print("❌ Missing --input")
            return
        output = args.output or f"{args.input}.gz"
        with open(args.input, "rb") as f:
            data = f.read()
        compressed = hella._compress_data(data, args.method)
        with open(output, "wb") as f:
            f.write(compressed)
        ratio = (1 - len(compressed) / len(data)) * 100 if len(data) > 0 else 0.0
        print(f"✅ Compressed: {len(data):,} → {len(compressed):,} bytes ({ratio:.1f}% reduction)")
        print(f"   Output: {output}")

    elif args.command == "decompress":
        if not args.input:
            print("❌ Missing --input")
            return
        output = args.output or args.input.replace(".gz", "").replace(".zlib", "")
        with open(args.input, "rb") as f:
            data = f.read()
        decompressed = hella._decompress_data(data, args.method)
        with open(output, "wb") as f:
            f.write(decompressed)
        print(f"✅ Decompressed: {len(data):,} → {len(decompressed):,} bytes")
        print(f"   Output: {output}")

    elif args.command == "register":
        register_packages(hella)


