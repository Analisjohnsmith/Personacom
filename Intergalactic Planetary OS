def materialize_payloads(payload_dir: str = "./hella2_payload") -> dict:
    """Write the lossless-packed payloads to disk and verify their hashes.

    Returns {package_key: path_to_written_file}. Raises ValueError on mismatch
    (i.e. the pack is NOT lossless).
    """
    os.makedirs(payload_dir, exist_ok=True)
    written = {}
    for key, info in _PACKED.items():
        raw = unpack_payload(info["payload"])
        if hashlib.sha256(raw).hexdigest() != info["sha256"]:
            raise ValueError(
                f"Hash mismatch for {key} — packed payload is corrupted. NOT lossless."
            )
        if len(raw) != info["size"]:
            raise ValueError(f"Size mismatch for {key} — packed payload is corrupted.")
        subdir = os.path.join(payload_dir, key)
        os.makedirs(subdir, exist_ok=True)
        path = os.path.join(subdir, info["filename"])
        with open(path, "wb") as f:
            f.write(raw)
        written[key] = path
    return written


def unpack_payload(b64: str) -> bytes:
    return unpack(b64)


