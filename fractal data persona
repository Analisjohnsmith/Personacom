## Implementation Outline

Below is a Python class that turns the fractal into an autonomous agent using **evolutionary parameter adaptation** (a simple form of learning). The agent’s mutation rates are treated as evolvable traits.

```python
import numpy as np
import hashlib
import os

class FractalAgent:
    def __init__(self, input_dim=1, action_dim=1,
                 base_params=(1.4, -1.6, 1.0, -0.7, 0.5),
                 mutation_scale=0.002,
                 learning_rate=0.01):
        # Internal state
        self.x, self.y, self.z = np.random.uniform(-1, 1, 3)
        self.a, self.b, self.c, self.d, self.e = base_params
        self.mutation_scale = mutation_scale

        # Learning parameters: we'll evolve the mutation scale per parameter
        self.mutation_rates = np.array([mutation_scale] * 5)  # for a,b,c,d,e
        self.learning_rate = learning_rate
        self.reward_trace = []

        # For action mapping
        self.input_dim = input_dim
        self.action_dim = action_dim

    def _step(self):
        """One fractal step (state update)."""
        x, y, z = self.x, self.y, self.z
        a, b, c, d, e = self.a, self.b, self.c, self.d, self.e

        x_new = np.sin(a * y) + e * np.cos(b * x)
        y_new = np.sin(b * z) + e * np.cos(c * y)
        z_new = np.sin(c * x) - np.cos(d * z)

        # Mutate parameters using evolved mutation rates
        a += self.mutation_rates[0] * np.sin(z)
        b += self.mutation_rates[1] * np.cos(x)
        c += self.mutation_rates[2] * np.sin(y)
        d += self.mutation_rates[3] * np.cos(z)
        e += self.mutation_rates[4] * np.sin(x + y)

        self.x, self.y, self.z = x_new, y_new, z_new
        self.a, self.b, self.c, self.d, self.e = a, b, c, d, e

    def perceive(self, sensory_input):
        """
        Incorporate external data into the fractal state.
        sensory_input: a numpy array of shape (input_dim,)
        We'll use it to perturb the state (like a stimulus).
        """
        if isinstance(sensory_input, (int, float)):
            sensory_input = np.array([sensory_input])
        # Ensure correct shape
        if sensory_input.ndim == 1:
            sensory_input = sensory_input.reshape(1, -1)

        # Perturb x,y,z based on sensory input (mapping to small deltas)
        delta = 0.1 * np.tanh(sensory_input.flatten())
        # Use only first 3 values if available
        if len(delta) >= 3:
            self.x += delta[0]
            self.y += delta[1]
            self.z += delta[2]
        else:
            # pad with zeros
            for i, val in enumerate(delta):
                if i == 0:
                    self.x += val
                elif i == 1:
                    self.y += val
                elif i == 2:
                    self.z += val

        # Keep within bounds (optional)
        self.x = np.clip(self.x, -2, 2)
        self.y = np.clip(self.y, -2, 2)
        self.z = np.clip(self.z, -2, 2)

    def act(self):
        """
        Map internal state to an action.
        Here we output the current z-coordinate (scaled) as a continuous action.
        Could also be a class decision or multi-dimensional output.
        """
        action = np.tanh(self.z)  # between -1 and 1
        return np.array([action])

    def learn(self, reward):
        """
        Update mutation rates using a simple reward‑based rule.
        Positive reward increases mutation rates (exploration),
        negative decreases (conservation).
        """
        self.reward_trace.append(reward)
        # Simple gradient‑free update: adjust rates proportional to reward
        # (this is a heuristic, not true RL, but demonstrates adaptation)
        adjustment = self.learning_rate * reward
        self.mutation_rates += adjustment * np.random.normal(0, 0.1, size=5)
        # Keep rates positive
        self.mutation_rates = np.maximum(self.mutation_rates, 1e-6)

    def step_environment(self, sensory_input, reward=None):
        """
        One full cycle: perceive, update internal dynamics, act, and optionally learn.
        """
        self.perceive(sensory_input)
        self._step()  # advance one fractal iteration
        action = self.act()
        if reward is not None:
            self.learn(reward)
        return action
```

