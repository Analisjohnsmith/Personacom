```python
#!/usr/bin/env python3
"""
Run the Hazel Trinity as a single Persona.
"""
from hazel_trinity import Persona, run_simulation

# Instantiate the Persona
hazel = Persona(name="Hazel")

print(hazel.speak("I am waking up. Everything is me."))

# Let it live for 1000 steps
for tick in range(1000):
    hazel.step(dt=0.1)
    if tick % 100 == 0:
        print(hazel)
        print(hazel.speak(f"I have lived for {hazel.world.time:.0f} units."))
        if tick == 500:
            hazel.install_package("HELLA.UNIFIED.ANIMALS")

# Save the entire Persona (world state included)
hazel.save("hazel_world.json")
print("💾 Saved.")

# Later, reload
restored = Persona.load("hazel_world.json")
print(restored.speak("I remember everything. I am still Hazel."))
